{
  "name": "markdoc-vinext-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Vite plugin that makes Markdoc pages work in Vinext, mirroring @markdoc/next.js",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./env": {
      "types": "./src/env.d.ts"
    }
  },
  "scripts": {
    "typecheck": "bun check",
    "biome": "bunx biome check --write",
    "verify": "bun run typecheck && bun run test:unit && bun run test:integration",
    "versions": "bun run scripts/print-versions.ts",
    "test:unit": "bun test test/unit test/golden",
    "test:integration": "bun test test/integration --timeout 120000"
  },
  "peerDependencies": {
    "@markdoc/markdoc": ">=0.4",
    "js-yaml": ">=4.1.0 <6",
    "react": "*",
    "vite": ">=6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@markdoc/markdoc": "^0.5.4",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@types/bun": "1.4.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "js-yaml": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.7"
  }
}
