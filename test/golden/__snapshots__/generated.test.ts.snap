{
  "code": 
"import React from 'react';
// js-yaml v5 には default export がなく、Vite 8 / Rolldown は default import をエラーにする。
import {load as yamlLoad} from 'js-yaml';
// default import は Vite の CJS interop と Node ESM の両方で動く。
import Markdoc from '@markdoc/markdoc';

import {getSchema, defaultObject, sanitizeFrontmatter} from "virtual:markdoc-vinext/runtime";
// スキーマモジュールは Vite のパイプライン (TypeScript / ESM) で処理する。
import * as config from "../../markdoc/config.ts";
import * as tags from "../../markdoc/tags.ts";
import * as nodes from "../../markdoc/nodes.ts";
import * as functions from "../../markdoc/functions.ts";
const schema = {
tags: defaultObject(tags),
nodes: defaultObject(nodes),
functions: defaultObject(functions),
...defaultObject(config),
};

const tokenizer = new Markdoc.Tokenizer(JSON.parse("{\\"allowComments\\":true}"));

const source = "---\\ntitle: Get started with Markdoc\\ndescription: How to get started with Markdoc on Vinext\\n---\\n\\n# {% $markdoc.frontmatter.title %}\\n\\n{% callout type=\\"info\\" %}\\nThis is a custom **callout** tag rendered by the sample schema.\\n{% /callout %}\\n\\nThe product variable is {% $product %}. Uppercased greeting: {% upper(\\"hello\\") %}.\\n\\n{% tag /%}\\n\\n{% partial file=\\"footer.md\\" /%}\\n";
const filepath = "/docs/getting-started.md";
const tokens = tokenizer.tokenize(source);
const parseOptions = {"slots":false};
const ast = Markdoc.parse(tokens, parseOptions);

// オブジェクト以外の YAML (\`~\`、\`null\`、スカラー) は {} にし、\`frontmatter.nextjs\` で例外を出さない。
const frontmatter = (() => {
  const loaded = ast.attributes.frontmatter ? yamlLoad(ast.attributes.frontmatter) : {};
  return loaded && typeof loaded === 'object' ? sanitizeFrontmatter(loaded) : {};
})();

const {components, ...rest} = getSchema(schema);

async function getMarkdocData(context = {}) {
  // "__proto__" 等のキーを自身のプロパティとして残すため、オブジェクトリテラルではなく JSON.parse を使う。
  const partials = JSON.parse("{\\"footer.md\\":\\"Footer partial: this line is included via \`{% partial file=\\\\\\"footer.md\\\\\\" /%}\`.\\\\n\\"}");

  // Markdoc.transform は partial を AST で受け取る。
  Object.keys(partials).forEach((key) => {
    const tokens = tokenizer.tokenize(partials[key]);
    partials[key] = Markdoc.parse(tokens, parseOptions);
  });

  const cfg = {
    ...rest,
    variables: {
      ...(rest ? rest.variables : {}),
      markdoc: {frontmatter},
      // getServerSideProps から渡すリクエスト時の変数。
      ...(context.variables || {})
    },
    partials,
    source,
  };

  // server 側の変数を使えるよう、データ取得関数の中で transform する。
  const content = await Markdoc.transform(ast, cfg);

  // undefined の値を除去する。
  return JSON.parse(
    JSON.stringify({
      content,
      frontmatter,
      file: {
        path: filepath,
      },
    })
  );
}

export async function getStaticProps(context) {
  return {
    props: {
      markdoc: await getMarkdocData(context),
    },
  };
}
export const markdoc = {frontmatter};
export default function MarkdocComponent(props) {
  const markdoc = props.markdoc;
  return Markdoc.renderers.react(markdoc.content, React, {
    components: {
      ...components,
      ...props.components,
    },
  });
}
"
,
